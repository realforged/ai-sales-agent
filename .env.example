# AI Sales Agent - Environment Variables
# No variables required for demo mode. All providers are mock implementations.

# Production variables (not needed for demo):

# OpenAI API key for real LLM-based extraction and response generation
# OPENAI_API_KEY=

# IndiaMART webhook secret for signature verification
# INDIAMART_WEBHOOK_SECRET=

# WhatsApp Cloud API access token for real message delivery
# WHATSAPP_ACCESS_TOKEN=

# PostgreSQL database URL
# DATABASE_URL=

# Redis URL for background job queues
# REDIS_URL=
